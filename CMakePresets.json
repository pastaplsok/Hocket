{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "vs2026",
      "displayName": "Visual Studio 2026 (x64)",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/vs2026",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "vs2026-symbols",
      "displayName": "Visual Studio 2026 (x64), Release with debug symbols, for stack samples",
      "inherits": "vs2026",
      "binaryDir": "${sourceDir}/build/vs2026-symbols",
      "cacheVariables": {
        "CMAKE_C_FLAGS_RELEASE": "/O2 /Ob2 /DNDEBUG /Zi",
        "CMAKE_CXX_FLAGS_RELEASE": "/O2 /Ob2 /DNDEBUG /Zi",
        "CMAKE_EXE_LINKER_FLAGS_RELEASE": "/DEBUG /INCREMENTAL:NO /OPT:REF /OPT:ICF"
      }
    }
  ],
  "buildPresets": [
    { "name": "vs2026-debug", "configurePreset": "vs2026", "configuration": "Debug" },
    { "name": "vs2026-release", "configurePreset": "vs2026", "configuration": "Release" },
    { "name": "vs2026-symbols", "configurePreset": "vs2026-symbols", "configuration": "Release" }
  ],
  "testPresets": [
    {
      "name": "vs2026-debug",
      "configurePreset": "vs2026",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "vs2026-release",
      "configurePreset": "vs2026",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    }
  ]
}
