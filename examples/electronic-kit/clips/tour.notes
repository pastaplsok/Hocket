# Each piece once at v127, half a bar apart; the crash and the ride get a bar each
@length 13bars

1.1      kick  1/16  v127
1.3      kick2 1/16  v127

2.1      snare 1/16  v127
2.3      snare2  1/16  v127

3.1      clap  1/16  v127
3.3      sidestick  1/16  v127

4.1      hat-closed  1/16  v127
4.3      hat-pedal  1/16  v127

5.1      hat-open  1/16  v127
5.3      tom-floor-low  1/16  v127

6.1      tom-floor-high  1/16  v127
6.3      tom-low  1/16  v127

7.1      tom-mid-low  1/16  v127
7.3      tom-mid-high  1/16  v127

8.1      tom-high  1/16  v127
8.3      conga-low  1/16  v127

9.1      conga-high-open  1/16  v127
9.3      conga-high-mute  1/16  v127

10.1     cowbell  1/16  v127
10.3     claves  1/16  v127

11.1     maracas  1/16  v127

12.1     crash 1/16  v127

13.1     ride  1/16  v127
