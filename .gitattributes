# Hocket project files are canonical text, compared byte for byte (SPEC §5.4,
# §4.4), so they're always checked out with LF, whatever core.autocrlf says.
# Name the text formats only: audio and plugin state in project folders are binary.
*.notes       text eol=lf
*.auto        text eol=lf
project.json  text eol=lf

# Audio is binary, however its bytes happen to look: never convert line endings in it.
*.wav         binary

# Bundled kits' text files: the generator (tools/kits) checks them byte for byte.
assets/kits/**/*.json  text eol=lf
assets/kits/**/*.txt   text eol=lf
