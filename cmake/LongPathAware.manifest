<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Lets the program use paths longer than 260 characters where Windows'
     long-path setting (LongPathsEnabled) is on: a project in a deep folder
     has kept saves whose paths pass 260 (SPEC 4.5). Merged with the manifest
     the linker makes. -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings xmlns:ws2="http://schemas.microsoft.com/SMI/2016/WindowsSettings">
      <ws2:longPathAware>true</ws2:longPathAware>
    </windowsSettings>
  </application>
</assembly>
